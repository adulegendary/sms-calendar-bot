# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here


#Notion API token here down below
NOTION_API_TOKEN=your_key_here
# Your public ngrok URL (no trailing slash) e.g. https://abc123.ngrok-free.app
PUBLIC_URL=https://your-ngrok-url-here

# Server port (optional, defaults to 3000)
PORT=3000

# Your local timezone (e.g. America/Toronto, America/New_York, Europe/London)
# Run: node -e "console.log(Intl.DateTimeFormat().resolvedOptions().timeZone)" to find yours
USER_TIMEZONE=America/Toronto
